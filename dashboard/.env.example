# Copy this file to dashboard/.env (already gitignored) and fill in your
# local vault path(s). Never commit the real .env — it points at private data.

# Absolute path to your general local Obsidian vault (NOT this repo).
# Quick Note and N-able Call captures write into <this path>/Inbox/.
SECOND_BRAIN_VAULT_PATH=/absolute/path/to/Conor-Second-Brain

# Optional. If set, Mortgage Call captures are routed here instead of
# SECOND_BRAIN_VAULT_PATH, as a separate vault — per docs/architecture.md,
# mortgage/client information stays segregated from the general second
# brain. Open both folders as separate vaults in Obsidian. Leave unset to
# route mortgage captures into the general vault too.
SECOND_BRAIN_VAULT_PATH_MORTGAGE=/absolute/path/to/Mortgage-Vault

# Optional — defaults to 8765.
SECOND_BRAIN_PORT=8765
